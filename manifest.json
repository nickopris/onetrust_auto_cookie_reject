{
  "manifest_version": 3,
  "name": "Auto Cookie Reject (testing)",
  "version": "1.3.0",
  "description": "Automatically clicks the OneTrust cookie banner Reject All button on any site.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Auto Cookie Reject"
  },
  "background": {
    "service_worker": "background.js"
  }
}